# Любые каталоги сборки CMake, включая разовые (asan, ubsan, tsan и т.п.)
/cmake-build-*/
/.idea/
/external/parallel-hashmap/.github/
/external/span-lite/.github/
/.vscode/
/build/
/vcpkg/
CMakeLists.txt.user
# Machine-specific CMake user presets (holds an absolute VCPKG_ROOT)
CMakeUserPresets.json
# Runtime storage / benchmark data created by tests
/tiny-mq/
/bench-mq/
# Рабочие пакеты событийной цепочки (.claude/chain): промпты стадий, логи
# headless-процессов, handoff-JSON. Эфемерны и привязаны к конкретному прогону —
# долговременный эвиденс живёт в docs/reviews/ и docs/features/.
/handoffs/
# Кеш neocmakelsp и прочих LSP — машинно-локальный артефакт
/.cache/

# Рабочие worktree агентов (создаются harness на время задачи)
/.claude/worktrees/

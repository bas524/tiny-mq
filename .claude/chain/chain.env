# Исполняемая привязка цепочки (исполняет route.py). Обоснование значений — CALIBRATION.md,
# и обе стороны обязаны совпадать: значение здесь без строки там — молчаливая калибровка
# (AEF, Приложение A, №17). Файл — единственное место, откуда маршрутизатор берёт имена обёрток и раскладку.

# Ручной режим Codex: каждая стадия запускается оператором в отдельной сессии.
CHAIN_EXEC=0
CHAIN_MAX_ITER=5
CHAIN_MAX_DISPATCH=12

# Обёртки процессного запуска: локальные исполняемые обёртки Codex (имя или путь от корня проекта).
WRAPPER_CRITIC="./.claude/chain/codex-deepseek-pro"
WRAPPER_PRODUCER="./.claude/chain/codex-openai"
WRAPPER_REVIEWER="./.claude/chain/codex-deepseek-pro"
WRAPPER_NFR="./.claude/chain/codex-deepseek-pro"
WRAPPER_CONFORMANCE="./.claude/chain/codex-openai"
WRAPPER_SECURITY="./.claude/chain/codex-deepseek-pro"
WRAPPER_DOCWRITER="./.claude/chain/codex-openai"
WRAPPER_EXPLAINER="./.claude/chain/codex-deepseek"

# Идентификаторы моделей, которые стадия обязана записать в provenance.model
# (совпадают с полем model: в заголовке соответствующего агента — вторая колонка CALIBRATION.md).
MODEL_CRITIC="deepseek-v4-pro"
MODEL_PRODUCER="gpt-6.1-sol"
MODEL_REVIEWER="deepseek-v4-pro"
MODEL_NFR="deepseek-v4-pro"
MODEL_CONFORMANCE="gpt-6.1-sol"
MODEL_SECURITY="deepseek-v4-pro"
MODEL_DOCWRITER="gpt-6.1-sol"
MODEL_EXPLAINER="deepseek-flash"

# Шлюзы специалистов после агента-рецензента, по порядку. Подмножество: nfr conformance security.
# Пустая строка означает сразу агента знания (doc-writer): осознанное решение, записанное в CALIBRATION.md.
SPECIALIST_GATES="nfr conformance security"

# Раскладка репозитория (PROJECT.md).
SPEC_DIR="docs/jms-spec"
HANDOFF_DIR="handoffs/current"
REVIEWS_DIR="docs/reviews"
OPENSPEC_DIR="openspec"
TEST_DIR="tests"

# Трассируемость требования (Стандарт 3): как идентификатор требования узнаётся в коде тестов.
REQ_ID_PATTERN="REQ-[0-9]{2}-[0-9]+"

# Репозиторий знания продукта (Стандарты 6 и 18): путь локального клона, относительно корня
# проекта или абсолютный. `—`, если у продукта один репозиторий и репозитория знания нет.
# Маршрутизатор останавливает цепочку, если в клоне есть изменения или неотправленные коммиты (KB-WRITE).
PRODUCT_KB_PATH="—"
COMPONENT_BINDING="—"

# Пилот на неполной оснастке (Стандарт 16, Приложение E): дата окончания исключения YYYY-MM-DD
# и путь к записи решения «Принятие риска» (templates/pilot-exception.md) с планом оценки. `—`, если оснастка полная.
# После даты маршрутизатор останавливает цепочку (PILOT-EXPIRED). Продление — новая запись по итогу оценки
# и новая дата, а не правка слота. Структуру плана маршрутизатор проверяет (PILOT-PLAN-*), содержание — человек.
PILOT_UNTIL="—"
PILOT_RECORD="—"

# Файлы, касание которых адресует консультацию владельцу агентной платформы (подстроки путей, через пробел).
PLATFORM_FILES="CMakeLists.txt CMakePresets.json vcpkg.json .github/ .codex/ AGENTS.md .claude/ handoffs/"

# Лимит критики намерения, отдельно от раундов реализации CHAIN_MAX_ITER.
CHAIN_MAX_CRITIC_ROUNDS="5"

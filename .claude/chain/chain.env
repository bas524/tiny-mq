# Исполняемая привязка цепочки (читает route.sh). Обоснование значений — CALIBRATION.md,
# и обе стороны обязаны совпадать: значение здесь без строки там — молчаливая калибровка
# (AEF Appendix A №17). Файл — единственное место, откуда роутер берёт имена обёрток и раскладку.

# Обёртки процессного запуска (shell-функции claude-<model> из ~/.zshrc).
WRAPPER_CRITIC="claude-glm-5-2"
WRAPPER_PRODUCER="claude-claude-sonnet-5"
WRAPPER_REVIEWER="claude-minimax-m3"
WRAPPER_PERF="claude-deepseek-v4-pro"
WRAPPER_CONFORMANCE="claude-glm-5-2"
WRAPPER_SECURITY="claude-deepseek-v4-pro"
WRAPPER_DOCWRITER="claude-glm-5-2"
WRAPPER_EXPLAINER="claude-glm-5-2"

# Идентификаторы моделей, которые стадия обязана записать в provenance.model
# (совпадают с frontmatter model: соответствующего агента — вторая колонка CALIBRATION.md).
MODEL_CRITIC="glm-5.2"
MODEL_PRODUCER="claude-sonnet-5"
MODEL_REVIEWER="MiniMax-M3"
MODEL_PERF="deepseek-v4-pro"
MODEL_CONFORMANCE="glm-5.2"
MODEL_SECURITY="deepseek-v4-pro"
MODEL_DOCWRITER="glm-5.2"
MODEL_EXPLAINER="glm-5.2"

# Гейты специалистов после Reviewer, по порядку. Подмножество: perf conformance security.
# Пустая строка = сразу doc-writer (осознанное решение, записанное в CALIBRATION.md).
SPECIALIST_GATES="perf"

# Раскладка репозитория.
SPEC_DIR="docs/jms-spec"
HANDOFF_DIR="handoffs"
REVIEWS_DIR="docs/reviews"
OPENSPEC_DIR="openspec"

# Файлы, касание которых адресует консультацию Agentic Platform Owner (подстроки путей, через пробел).
PLATFORM_FILES="CMakeLists.txt vcpkg.json CMakePresets.json .claude/ handoffs/"

# Модель поставки (AEF Том II §2.2): один развёрнутый экземпляр — знание живёт в главной ветке.
# Релизов и линейки версий у проекта нет до M5; с их появлением сюда добавляется
# SUPPORTED_VERSIONS и сверка садовника идёт по каждой поддерживаемой версии.
RELEASE_MODEL="один развёрнутый экземпляр"
SUPPORTED_VERSIONS="—"
